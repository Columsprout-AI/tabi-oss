# Runtime
NODE_ENV=production
PORT=5001

# Mongo (stores batches/intermediates)
MONGO_URI=mongodb://<user>:<pass>@<host>:27017/columsprout_tabi?authSource=admin

# Callback back to int-or (use the Docker service name in compose)
INTOR_URL=http://int-or:3000

# Default bucket used by /api/ing/output-path
# (You can also pass "bucketName" in the request body to override per call.)
BUCKET_NAME=

# --- GCP Auth (ADC) ---
# Locally, run: gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON key.
# In GCP (VM/Cloud Run/etc.), attach a service account with:
#   Storage Object Viewer (read from uploads/)
#   Storage Object Creator (write to outputs/)
