# Runtime
NODE_ENV=production
PORT=3000

# PostgreSQL
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# Mongo (used for a few lookups + consistency with other services)
MONGO_URI=

# Clerk
CLERK_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Internal service URLs (use Docker service names in compose)
INGESTION_URL=http://ingestion:5001
EXPERIMENT_URL=http://experiment:5002
PROCESSING_URL=http://processing:5003

# FE webhook base (must be publicly reachable if FE is separate)
FRONTEND_WEBHOOK_URL=https://<your-fe-domain>

# FX (used by payments cron)
EXCHANGE_RATES_API_KEY=

# Free credits for new users
FREE_USER_CREDITS=10
