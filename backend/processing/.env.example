# Runtime
NODE_ENV=production
PORT=5003

# MongoDB (same cluster as ingestion)
MONGO_URI=
DB_NAME=columsprout-tabi

# OpenAI Assistants
OPENAI_API_KEY=
ASSISTANT_ID=

# Callback to int-or (Docker compose service name inside the network)
INTOR_URL=http://int-or:3000

# Optional knobs (leave unset to use defaults)
# MARKUP_CONSTANT=1.2
# TOKEN_COST_PER_MILLION_INPUT=0.15
# TOKEN_COST_PER_MILLION_OUTPUT=0.6
# MAX_RUN_RETRIES=20
# RUN_RETRY_DELAY_MS=5000
